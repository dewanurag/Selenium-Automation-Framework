<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="ATFSuite">
  <listeners>
  	<listener class-name="com.ui.listeners.AnnotationTransformer"></listener>
  	<listener class-name="com.ui.listeners.TestListener"></listener>
  </listeners>
  <test thread-count="3" name="LoginTests" parallel="methods" preserve-order="true">
  <parameter name="browser" value="${browser}"></parameter>
  <parameter name="isLambdaTest" value="${isLambdaTest}"></parameter>
  <parameter name="isHeadless" value="${isHeadless}"></parameter>
    <classes>
      <class name="com.ui.tests.LoginTest3">
      	<methods>
      		<exclude name="testLogin"></exclude>
      	</methods>
      </class>
    </classes>
  </test> <!-- LoginTest -->
</suite> <!-- Suite -->
